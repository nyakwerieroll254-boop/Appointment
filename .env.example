PORT=3000
DB_PATH=./data/bookings.sqlite
# Set a long random value before exposing the protected booking-management API.
ADMIN_API_TOKEN=

# Gmail SMTP. Use a Gmail App Password (not your regular account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=nyakwerieroll254@gmail.com
SMTP_PASS=
EMAIL_FROM="Eroll Josephat <nyakwerieroll254@gmail.com>"
BOOKING_NOTIFICATION_EMAIL=nyakwerieroll254@gmail.com

# Africa's Talking SMS notifications.
AFRICASTALKING_ENVIRONMENT=sandbox
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

# Pesapal API 3.0 hosted checkout for card and M-Pesa.
# Create a Pesapal merchant account, set the public HTTPS site URL, then
# register the IPN using POST /api/admin/pesapal/ipn with the admin token.
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_IPN_ID=
PUBLIC_BASE_URL=https://your-public-domain.example

# Direct Safaricom Daraja STK Push to an M-Pesa Paybill. Use the sandbox
# until a Safaricom Paybill shortcode and production credentials are issued.
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=https://your-public-domain.example/api/payments/daraja/callback
